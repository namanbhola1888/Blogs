# ==========================================
# CHRONICLE — Premium Editorial Platform
# Sanity CMS & Vercel Environment Configuration
# ==========================================

# Your Sanity.io Project ID (from https://www.sanity.io/manage)
# If left empty, Chronicle seamlessly runs in high-craft Mock Fallback Mode
VITE_SANITY_PROJECT_ID=your_sanity_project_id

# Your Sanity Dataset (usually 'production')
VITE_SANITY_DATASET=production

# Sanity API Version date
VITE_SANITY_API_VERSION=2024-01-01
